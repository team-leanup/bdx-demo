# BDX 환경변수 (Vercel Project Settings 또는 .env.local 에 설정)
# 미설정 시 Supabase 클라이언트가 placeholder 로 동작해 모든 DB 호출이 실패합니다.

# Supabase 프로젝트 URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable 키 (둘 중 사용하는 쪽을 채우면 됨)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
